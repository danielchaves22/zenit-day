{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenit Day",
  "version": "0.1.5",
  "identifier": "br.com.equinox.zenitday",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenit Day",
        "width": 1220,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#f5f8fc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://*.supabase.co; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "android": { "minSdkVersion": 26 }
  }
}
